 {
  "name": "名古屋大学",
  "story": {
   "summary": "9学部・13研究科をもつ総合大学で、2000年以降に6名のノーベル賞受賞者を出している。入学後は全学部の1年生が基礎セミナーや、TOEFL ITPの結果に応じたクラス分けの英語などの全学教育を受け、学部をまたいで学ぶ。岐阜大学と東海国立大学機構をつくり、海外の大学に名古屋大学のキャンパスを置くなど、東海地方にいながら研究と国際交流の機会を求める生徒に話せる。",
   "only": [
    {
     "t": "2000年以降のノーベル賞受賞者が6名（野依良治・下村脩・小林誠・益川敏英・赤﨑勇・天野浩）",
     "src": "https://www.nagoya-u.ac.jp/about-nu/upload_images/NU_profile2026_1.pdf"
    },
    {
     "t": "2020年に岐阜大学と法人統合して東海国立大学機構を設立。2018年に指定国立大学法人に選ばれている",
     "src": "https://www.nagoya-u.ac.jp/about-nu/upload_images/NU_profile2026_1.pdf"
    },
    {
     "t": "1年生は学部・学科ごとに開かれる基礎セミナーから希望して履修し、英語は新入生全員が受けるTOEFL ITPの結果でコースが分かれる（2026年度）",
     "src": "https://office.ilas.nagoya-u.ac.jp/files/kyomu/2026_Guidance_Video/2026_Guidance.pdf"
    },
    {
     "t": "509件の学術交流協定（63の国・地域）があり、ノースカロライナ州立大学・シンガポール国立大学などに名古屋大学のキャンパスを設置している",
     "src": "https://www.nagoya-u.ac.jp/about-nu/upload_images/NU_profile2026_1.pdf"
    }
   ],
   "vs": [
    {
     "u": "名古屋工業大学",
     "t": "名古屋工業大学は工学部だけの単科大学で工学を深く学ぶのに対し、名古屋大学は工学部に加えて文・教育・法・経済・情報・理・医・農学部がそろう",
     "src": "https://search.keinet.ne.jp/1255/outline/department"
    },
    {
     "u": "東北大学",
     "t": "東北大学は歯学部・薬学部を含む10学部、名古屋大学は情報学部を含む9学部で、歯学・薬学を学ぶなら東北大学、情報学部で学ぶなら名古屋大学になる",
     "src": "https://search.keinet.ne.jp/1050/outline/department"
    }
   ]
  }
 },
 {
  "name": "九州大学",
  "story": {
   "summary": "4つのキャンパスに12学部をもつ総合大学で、全学部で学部の枠を超えた対話型の学びを重視する基幹教育を行う。2018年に設置された共創学部は海外留学とチーム型学習が必修で、芸術工学部ではデザインを工学と合わせて学べる。単一キャンパスとして国内最大規模の伊都キャンパスを拠点に、九州で幅広い分野と留学の機会を求める生徒に話せる。",
   "only": [
    {
     "t": "共創学部（2018年設置）は地球の持続可能性に関する社会課題の解決をめざし、海外大学への留学とチーム型学習が必修",
     "src": "https://www.kyushu-u.ac.jp/f/62301/guidebook_2026.pdf"
    },
    {
     "t": "芸術工学部（2003年に九州芸術工科大学と統合）は芸術工学科1学科5コースで、大学は「日本でも数少ない学部」と紹介している",
     "src": "https://www.kyushu-u.ac.jp/f/62301/guidebook_2026.pdf"
    },
    {
     "t": "伊都キャンパス（2005年開設）は「単一キャンパスとしては国内最大規模」とされ、再生可能エネルギーや新しいモビリティの実証実験が行われている",
     "src": "https://www.kyushu-u.ac.jp/f/62301/guidebook_2026.pdf"
    },
    {
     "t": "学生交流協定は34か国・140を超える大学と結ばれ、毎年100人程度が交換留学に出ている（留学先の授業料は不要）",
     "src": "https://www.kyushu-u.ac.jp/f/62301/guidebook_2026.pdf"
    }
   ],
   "vs": [
    {
     "u": "熊本大学",
     "t": "熊本大学は情報融合学環・共創学環という学環を置き、九州大学は共創学部（海外留学が必修）と芸術工学部を置く",
     "src": "https://search.keinet.ne.jp/1440/outline/department"
    },
    {
     "u": "広島大学",
     "t": "広島大学は総合科学部・生物生産学部・情報科学部を含む12学部、九州大学は共創学部・芸術工学部を含む12学部で、デザイン系を学ぶなら九州大学の芸術工学部が選択肢になる",
     "src": "https://search.keinet.ne.jp/1360/outline/department"
    }
   ]
  }
 }
