 {
  "name": "宇都宮大学",
  "story": {
   "summary": "栃木県の国立大学で、地域デザイン科学部・データサイエンス経営学部など地域課題やデータ活用に直結する学部をそろえる。工学部は光工学や工農連携を研究の特色とし、農学部には森林科学まで学べる学科がある。群馬大学と比べると、農学部・国際学部・地域デザイン科学部があり、建築・まちづくりや農・食の分野も選べる点が違う。",
   "only": [
    {
     "t": "データサイエンス経営学部は2年次前期までデータサイエンスと経営学の基礎を共通に学び、2年次後期にどちらかの学系を選ぶ",
     "src": "https://search.keinet.ne.jp/1090/outline/department"
    },
    {
     "t": "地域デザイン科学部は行政・産業・NPOと連携したまちづくり（コミュニティデザイン）と、建築都市・社会基盤デザインの3学科で地域づくりを学ぶ",
     "src": "https://search.keinet.ne.jp/1090/outline/department"
    },
    {
     "t": "教員養成は群馬大学との共同教育学部で行い、1年次から専門分野を問わない混合クラスで4年間同じ指導教員が指導する",
     "src": "https://search.keinet.ne.jp/1090/outline/department"
    },
    {
     "t": "工学部は光工学・工農連携・医用生命工学などを研究の特色とし、2年次から3コースに分かれる",
     "src": "https://search.keinet.ne.jp/1090/outline/department"
    }
   ],
   "vs": [
    {
     "u": "群馬大学",
     "t": "群馬大学は医学部（医学科・保健学科）と文理横断の情報学部を持つが、宇都宮大学は農学部・国際学部・地域デザイン科学部（建築・土木・まちづくり）を持つ",
     "src": "https://search.keinet.ne.jp/1095/outline/department"
    }
   ]
  }
 },
 {
  "name": "群馬大学",
  "story": {
   "summary": "群馬県の国立大学で、医学部（医学科・保健学科4専攻）と、文理横断で情報社会を学ぶ情報学部、類で入学して2年次後期にプログラムを選ぶ理工学部をそろえる。教員養成は宇都宮大学との共同教育学部で、13専攻から教科を選べる。宇都宮大学と比べると、医師・看護師・臨床検査技師・理学療法士・作業療法士などの医療職を目指せる点が違う。",
   "only": [
    {
     "t": "医学部保健学科に看護学・検査技術科学・理学療法学・作業療法学の4専攻があり、看護師・保健師・助産師・臨床検査技師・理学療法士・作業療法士などの医療職を目指せる",
     "src": "https://search.keinet.ne.jp/1095/outline/department"
    },
    {
     "t": "情報学部は人文・社会科学と情報科学の両面から学ぶ文理横断型で、人文情報・社会共創・データサイエンス・計算機科学の4プログラムがある",
     "src": "https://search.keinet.ne.jp/1095/outline/department"
    },
    {
     "t": "理工学部は入学時に「類」に所属し、2年次後期以降に8つのプログラムから適性に応じて選ぶ",
     "src": "https://search.keinet.ne.jp/1095/outline/department"
    },
    {
     "t": "共同教育学部は宇都宮大学と共同で設置し、4つの系・13の専攻がある",
     "src": "https://search.keinet.ne.jp/1095/outline/department"
    }
   ],
   "vs": [
    {
     "u": "宇都宮大学",
     "t": "宇都宮大学は農学部・国際学部・地域デザイン科学部を持つが、群馬大学は医学部（医学科・保健学科）と文理横断の情報学部を持つ",
     "src": "https://search.keinet.ne.jp/1090/outline/department"
    }
   ]
  }
 }
