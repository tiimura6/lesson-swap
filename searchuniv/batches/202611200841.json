[
 {
  "name": "東京電機大学",
  "info": {
   "research": [
    "未来科学部：建築・情報メディア・ロボット・メカトロニクスの3学科が連携し、人間を中心に据えたデザイン力を養うことを特色とする。東京千住キャンパスで学ぶ。",
    "工学部：電気電子工・電子システム工・応用化学・機械工・先端機械工・情報通信工の6学科。3段階に組まれた教育課程と、全学年で行う実験・実習を通して知識と技術を身につける。東京千住キャンパス。",
    "システムデザイン工学部：情報システム工学科とデザイン工学科の2学科。工学と人間の調和を重んじ、これからのものづくりを担う力を育てる。東京千住キャンパスで学ぶ。",
    "理工学部：理学系・生命科学系・情報システムデザイン学系・機械工学系・電子情報工学系・建築・都市環境学系の6学系を埼玉鳩山キャンパスに置き、次世代の科学技術者を育てる。",
    "工学部第二部：夜間に電気電子工・機械工・情報通信工の3学科で学べる。学費はおよそ工学部の半分で、工学部と同じ教授陣・施設を利用できる。東京千住キャンパス。"
   ],
   "sources": [
    "https://search.keinet.ne.jp/2259/outline/department",
    "https://manabi.benesse.ne.jp/daigaku/school/3291/gakubu/"
   ]
  }
 },
 {
  "name": "関西外国語大学",
  "info": {
   "research": [
    "外国語学部：英米語・英語・デジタルコミュニケーション・国際日本・スペイン語の4学科。英語を軸に、経済・経営やITスキル、日本文化など幅広い分野へ学びを広げる。",
    "英語キャリア学部：英語キャリア学科と英語－小学校教員学科。高度な英語コミュニケーション力を身につけ、国際社会で活躍できる人材を育てる。米国公認会計士（USCPA）の取得を目指す授業もある。",
    "英語国際学部：英語－国際関係学、英語－グローバル・コミュニケーション学、2025年新設のアジア共創で構成。社会の変化に対応できるグローバル人材の育成を掲げる。",
    "国際共生学部：国際共生学科の1学科（入学定員70人）。4年間すべての授業を英語で受け、留学生とともに学ぶ。"
   ],
   "sources": [
    "https://search.keinet.ne.jp/2535/outline/department",
    "https://shingakunet.com/gakko/SC000190/",
    "https://manabi.benesse.ne.jp/daigaku/school/3646/"
   ]
  }
