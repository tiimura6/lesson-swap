 {
  "name": "東京都立大学",
  "story": {
   "summary": "人文社会から理工・健康福祉まで7学部をそろえる公立の総合大学。法学部の法曹コースや、システムデザイン学部の学科をまたぐ教育、都市環境学部のフィールドワーク重視など、学部ごとに実務・実践につながる仕組みがある。横浜市立大学と比べると、工学系（システムデザイン）や医療・福祉の専門職を育てる健康福祉学部まで一つの大学で選べる点が違う。",
   "only": [
    {
     "t": "法学部に法科大学院と連携した「法曹養成プログラム（法曹コース）」があり、司法試験合格までの期間を短縮できる可能性がある",
     "src": "https://search.keinet.ne.jp/1532/outline/department"
    },
    {
     "t": "システムデザイン学部は情報系を強化した5学科体制で、学科間の連携による分野横断的な教育を行う",
     "src": "https://search.keinet.ne.jp/1532/outline/department"
    },
    {
     "t": "都市環境学部は実験・実習・フィールドワークや課題解決・提案型演習を重視し、多彩なインターンシップを実施している",
     "src": "https://search.keinet.ne.jp/1532/outline/department"
    },
    {
     "t": "経済経営学部は1年次に経済学と経営学の両方を学び、2年次に経済学コースか経営学コースを選ぶ",
     "src": "https://search.keinet.ne.jp/1532/outline/department"
    }
   ],
   "vs": [
    {
     "u": "横浜市立大学",
     "t": "横浜市立大学はデータサイエンス学部や医学部を持つ5学部の大学だが、東京都立大学はシステムデザイン学部（5学科）・都市環境学部・健康福祉学部を含む7学部で、工学系や医療・福祉の専門職の分野も選べる",
     "src": "https://search.keinet.ne.jp/1540/outline/department"
    }
   ]
  }
 },
 {
  "name": "横浜市立大学",
  "story": {
   "summary": "国際教養・国際商・理・データサイエンス・医の5学部からなる公立大学。2018年に開設したデータサイエンス学部は、統計学と計算機科学に社会科学を加えた文理融合のカリキュラムで、企業や自治体と連携したPBLで課題解決を学ぶ。学部どうしの連携も特徴で、国際商学部ではデータサイエンス学部や医学部と組んだ独自の科目を学べる。",
   "only": [
    {
     "t": "データサイエンス学部（2018年4月設置）は統計学・計算機科学に社会科学を加えた文理融合型で、企業や自治体と連携したPBLを行う",
     "src": "https://www.yokohama-cu.ac.jp/univ/outline/estab/tt534t00000005q0-att/secchishushi.pdf"
    },
    {
     "t": "国際商学部はデータサイエンス学部や医学部と連携し、「計量経済学」「医療イノベーション経営管理論」などの科目を用意し、海外企業でのインターンシップも行う",
     "src": "https://search.keinet.ne.jp/1540/outline/department"
    },
    {
     "t": "理学部には1年次から研究に取り組める「理数マスター育成プログラム」と、海外志向の研究マインドを養う「国際リトリートプログラム」がある",
     "src": "https://search.keinet.ne.jp/1540/outline/department"
    },
    {
     "t": "国際教養学部は2年次から「教養学系」と「都市学系」の2学系・4クラスターから専門を選ぶ",
     "src": "https://search.keinet.ne.jp/1540/outline/department"
    }
   ],
   "vs": [
    {
     "u": "東京都立大学",
     "t": "東京都立大学は工学系や健康福祉を含む7学部の総合大学だが、横浜市立大学は5学部の規模で、データサイエンス学部・医学部と文系学部が連携した科目を学べる",
     "src": "https://search.keinet.ne.jp/1532/outline/department"
    }
   ]
  }
 }
