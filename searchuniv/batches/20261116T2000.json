 {
  "name": "松山東雲女子大学",
  "story": {
   "summary": "松山東雲女子大学は、1886年設立の松山女学校を源流とする松山市の女子大学で、人文科学部に子ども・社会福祉・地域イノベーションの専攻を置いています。地域イノベーション専攻では愛媛県との連携協定によるPBL型授業や、道後商店街・大洲市でのフィールドワークを通じて、データサイエンスと地域の課題解決を学びます。地元愛媛で、保育・福祉や地域×デジタルの分野を少人数の女子大学で学びたい生徒に話しやすい大学です。",
   "only": [
    {
     "t": "1886年に設立された松山女学校を源流とし、1906年にミッション・スクールとなった歴史をもつ。",
     "src": "https://search.keinet.ne.jp/2689"
    },
    {
     "t": "地域イノベーション専攻では、愛媛県との連携協定によるPBL（課題解決）型授業や、道後商店街・大洲市でのフィールドワークを行う。",
     "src": "https://college.shinonome.ac.jp/faculty/shinri-chiiki/"
    },
    {
     "t": "文系からでも数理・情報の基礎から学べ、「数理・データサイエンス・AI教育プログラム（リテラシーレベル）」の修了証や、ITパスポート・基本情報技術者などの試験を目指せる。",
     "src": "https://college.shinonome.ac.jp/faculty/shinri-chiiki/"
    }
   ],
   "vs": [
    {
     "u": "松山大学",
     "t": "同じ松山市の松山大学は経済・経営・人文・法・情報・薬の6学部をもつ共学の総合大学だが、松山東雲女子大学は女子大学として人文科学部の中で子ども・社会福祉・地域イノベーションを学ぶ。",
     "src": "https://www.matsuyama-u.ac.jp/guide/president/president-message/"
    },
    {
     "u": "聖カタリナ大学",
     "t": "同じ松山市の聖カタリナ大学は健康社会学部と看護学部の構成だが、松山東雲女子大学は地域イノベーション専攻でデータサイエンスと地域課題の解決を学べる。",
     "src": "https://www.catherine.ac.jp/course"
    }
   ]
  }
 },
 {
  "name": "梅光学院大学",
  "story": {
   "summary": "梅光学院大学は、1872年に長崎で開かれた聖書と英語の塾を源流とする下関市のキリスト教主義の大学で、国際学部と子ども学部を置いています。「全員留学」を掲げた3段階の海外留学プログラムや、ANAとの教育連携プログラム、4年間のチューター制度などがあります。語学・観光・航空など海外とつながる仕事や、小学校・幼児教育を目指す生徒に話しやすい大学です。",
   "only": [
    {
     "t": "「全員留学」を掲げ、英語・中国語・韓国語などの3段階海外留学プログラムを用意している。",
     "src": "https://www.baiko.ac.jp/university/"
    },
    {
     "t": "ANA教育連携プログラムを設けている。",
     "src": "https://www.baiko.ac.jp/university/"
    },
    {
     "t": "学生一人ひとりを4年間サポートする「チューター制度」があり、昼の「マイニチ礼拝」を行っている。",
     "src": "https://www.baiko.ac.jp/university/"
    }
   ],
   "vs": [
    {
     "u": "下関市立大学",
     "t": "同じ下関市の下関市立大学は経済・看護・データサイエンスの3学部構成だが、梅光学院大学は国際学部で英語・中国語・韓国語や国際観光を、子ども学部で児童教育・幼児保育を学ぶ。",
     "src": "https://search.keinet.ne.jp/1665/outline/department"
    },
    {
     "u": "東亜大学",
     "t": "同じ下関市の東亜大学は医療・芸術・人間科学（スポーツ健康など）の学科を置くが、梅光学院大学は語学・留学と教育・保育を中心に学ぶ。",
     "src": "https://search.keinet.ne.jp/2652"
    }
   ]
  }
 }
