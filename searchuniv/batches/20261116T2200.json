 {
  "name": "岡山理科大学",
  "story": {
   "summary": "岡山市の岡山キャンパスに理・工・情報理工・生命科学・生物地球・教育・経営の7学部、愛媛県今治市のキャンパスに獣医学部を置く大学です。恐竜学科のゴビ砂漠を含むフィールドワーク、獣医学科と獣医保健看護学科、学部を超えて自分でカリキュラムを設計するアクティブラーナーズコースなど、理系を中心に幅広い分野から選べます。恐竜・化石や動物、教員、医療技術などをめざす生徒に話しやすい大学です。",
   "only": [
    {
     "t": "生物地球学部恐竜学科は、モンゴル・ゴビ砂漠を含む国内外のフィールドワークを行い、古生物学・地質学に生命科学の視点を加えて恐竜を中心とした脊椎動物化石を学ぶ（パスナビは「国内では珍しい」と紹介）。",
     "src": "https://passnavi.obunsha.co.jp/univ/4650/department/"
    },
    {
     "t": "獣医学部（今治キャンパス）に獣医学科と獣医保健看護学科を置き、動物看護師や公務員などの獣医関連専門家（VPP）の育成もめざす。",
     "src": "https://passnavi.obunsha.co.jp/univ/4650/department/"
    },
    {
     "t": "アクティブラーナーズコースは固定カリキュラムを持たず、岡山キャンパスのどの授業も履修して、アドバイザーと相談しながら自分のカリキュラムを設計できる。",
     "src": "https://passnavi.obunsha.co.jp/univ/4650/department/"
    },
    {
     "t": "理学部応用数学科は数学と情報、基礎理学科は数学・理科・情報の教員免許を同時に取得できる。",
     "src": "https://passnavi.obunsha.co.jp/univ/4650/department/"
    }
   ],
   "vs": [
    {
     "u": "福井県立大学",
     "t": "福井県立大学は恐竜学部恐竜・地質学科を置く公立大学だが、岡山理科大学は生物地球学部恐竜学科で、ゴビ砂漠を含むフィールドワークと生命科学の視点から恐竜を中心とした脊椎動物化石を学ぶ。",
     "src": "https://www.fpu.ac.jp/news_category/category/entrance-examination/q156691_d/fil/1.pdf"
    },
    {
     "u": "山口大学",
     "t": "山口大学は共同獣医学部に共同獣医学科を置く国立大学だが、岡山理科大学は獣医学部に獣医学科に加えて獣医保健看護学科があり、動物看護師などの獣医関連専門家もめざせる。",
     "src": "https://search.keinet.ne.jp/1365/outline/department"
    }
   ]
  }
 },
 {
  "name": "川崎医療福祉大学",
  "story": {
   "summary": "倉敷市にある、医療福祉・保健看護・リハビリテーション・医療技術・医療福祉マネジメントの5学部の大学です。隣接する川崎医科大学附属病院などでの実習が多く、福祉・心理・保育から、看護、リハビリ、臨床検査・放射線・栄養、医療情報まで、医療と福祉の仕事を幅広く選べます。医療・福祉の専門職をめざす生徒に話しやすい大学です。",
   "only": [
    {
     "t": "理学療法学科・作業療法学科は、隣接する川崎医科大学附属病院で1年次から臨床見学・実習を行う。",
     "src": "https://passnavi.obunsha.co.jp/univ/4665/department/"
    },
    {
     "t": "医療データサイエンス学科で医療情報技師と診療情報管理士のダブルライセンスの取得が可能で、3年次に病院実習がある。",
     "src": "https://passnavi.obunsha.co.jp/univ/4665/department/"
    },
    {
     "t": "医療福祉学科で社会福祉士・精神保健福祉士に加えて小学校・特別支援学校の教員免許状、臨床心理学科で公認心理師養成カリキュラム、医療保育学科で病院実習を含む保育士養成と、福祉・心理・保育の学科がそろう。",
     "src": "https://passnavi.obunsha.co.jp/univ/4665/department/"
    },
    {
     "t": "リハビリテーション学部に理学療法・作業療法・言語聴覚療法に加えて視能療法学科を置き、視能訓練士を養成する。",
     "src": "https://passnavi.obunsha.co.jp/univ/4665/department/"
    }
   ],
   "vs": [
    {
     "u": "広島国際大学",
     "t": "広島国際大学は総合リハビリテーション学部で理学療法・作業療法・言語聴覚療法を学ぶが、川崎医療福祉大学はこれらに加えて視能療法学科があり、隣接する川崎医科大学附属病院での実習を行う。",
     "src": "https://www.hirokoku-u.ac.jp/admission/cms/wp-content/themes/admission_theme/files/examination/2027_senbatsuyouko_senbatsu.pdf"
    }
   ]
  }
 }
