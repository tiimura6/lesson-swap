 {
  "name": "関西大学",
  "story": {
   "summary": "関西大学は14学部をもち、社会安全学部では法・経済・社会・工・医・心理などを横断する文理融合で、自然災害と事故・危機管理の両方から社会の安全を学ぶ。2025年にはビジネスデータサイエンス学部を開き、文理を統合し企業と連携した課題解決型の学びも選べる。",
   "only": [
    {
     "t": "社会安全学部は、事故防止・リスクマネジメント・危機管理の「社会災害マネジメント科目」と、防災・減災・被災者支援・復興の「自然災害マネジメント科目」の2つの群を、文理融合で学ぶ",
     "src": "https://www.kansai-u.ac.jp/kyoshoku/disclosure/assets/index/goal/10_Societal Safety Sciences.pdf"
    },
    {
     "t": "社会安全学部 安全マネジメント学科では、中学校「社会」・高等学校「公民」の教員免許（一種）が取れる",
     "src": "https://www.kansai-u.ac.jp/kyoshoku/disclosure/assets/index/goal/10_Societal Safety Sciences.pdf"
    },
    {
     "t": "2025年4月に14番目の学部としてビジネスデータサイエンス学部を開設し、文系と理系を統合した、企業と連携する課題解決型のカリキュラムを置く",
     "src": "https://www.kansai-u.ac.jp/ja/assets/pdf/about/pr/press_release/2024/No69.pdf"
    }
   ],
   "vs": [
    {
     "u": "同志社大学",
     "t": "同志社大学は情報と文化を結ぶ文化情報学部を置くが、関西大学は総合情報学部に加えてビジネスデータサイエンス学部で、データをビジネスの課題解決に使う学びを選べる",
     "src": "https://search.keinet.ne.jp/2498/outline/department"
    }
   ]
  }
 },
 {
  "name": "南山大学",
  "story": {
   "summary": "南山大学はカトリック系の大学で、外国語・人文・国際教養・法・総合政策・経済・経営・理工の8学部を名古屋キャンパス（名古屋市昭和区）1か所に集めている。外国語学部は英米・スペイン・ラテンアメリカ・フランス・ドイツ・アジアの5学科から言語と地域を選べ、文系と理工系の学生が同じキャンパスで学ぶ。",
   "only": [
    {
     "t": "8学部すべてを名古屋キャンパスに集約している（瀬戸キャンパスは2017年に閉鎖）",
     "src": "https://search.keinet.ne.jp/univtop/2460"
    },
    {
     "t": "外国語学部に英米・スペイン・ラテンアメリカ・フランス・ドイツ・アジアの5学科を置く",
     "src": "https://search.keinet.ne.jp/univtop/2460"
    },
    {
     "t": "人文学部にキリスト教学科（1962年に神学科として設置）があり、キリスト教を学問として学べる",
     "src": "https://search.keinet.ne.jp/univtop/2460"
    }
   ],
   "vs": [
    {
     "u": "愛知大学",
     "t": "愛知大学は中国を専門に学ぶ現代中国学部を置くが、南山大学は外国語学部の5学科から英語圏・ヨーロッパ・中南米・アジアの言語と地域を選んで学ぶ",
     "src": "https://search.keinet.ne.jp/2436/outline/expense"
    },
    {
     "u": "中京大学",
     "t": "中京大学は名古屋と豊田の2キャンパスでスポーツ科学部などを置くが、南山大学は全8学部を名古屋キャンパス1か所に集めている",
     "src": "https://search.keinet.ne.jp/2446/outline/expense"
    }
   ]
  }
 }
