 {
  "name": "札幌保健医療大学",
  "story": {
   "summary": "札幌保健医療大学は札幌市にある保健医療学部（看護学科・栄養学科、入学定員計120人）だけの小規模大学です。看護と栄養の合同科目でチーム医療の考え方を身につけ、病院・保健所・学校などでの臨地実習を重ねて、看護師・保健師・管理栄養士などの国家試験をめざします。",
   "only": [
    {
     "t": "看護学科と栄養学科の合同科目があり、両学科の学生が同じ授業・同じグループで課題に取り組む。",
     "src": "https://www.sapporo-hokeniryou-u.ac.jp/about/characteristic"
    },
    {
     "t": "1学科1学年に3〜4名の学担教員を置き、教員の研究室が学生の学習スペースの近くにある。",
     "src": "https://www.sapporo-hokeniryou-u.ac.jp/about/characteristic"
    },
    {
     "t": "北海道の風土・歴史・食文化・アイヌ文化を学ぶ科目があり、栄養学科は大学農園「WILL FARM」で体験的に学ぶ。",
     "src": "https://www.sapporo-hokeniryou-u.ac.jp/about/characteristic"
    },
    {
     "t": "栄養学科は1年次から「食育実践」「スポーツ栄養」「臨床栄養」の3つの選択コースがあり、看護学科は看護師＋養護教諭の養成も行う。",
     "src": "https://passnavi.obunsha.co.jp/univ/1536/department/"
    }
   ],
   "vs": [
    {
     "u": "天使大学",
     "t": "天使大学は看護栄養学部（看護学科定員100・栄養学科定員90）で学生数754人だが、この大学は看護80・栄養40の計120人定員で、学年ごとの学担教員と両学科の合同科目を置いている。",
     "src": "https://search.keinet.ne.jp/2022/outline/department"
    }
   ]
  }
 },
 {
  "name": "グローバルBiz専門職大学",
  "story": {
   "summary": "グローバルBiz専門職大学は神奈川県川崎市の1学部1学科（グローバルビジネス学部、入学定員98人）の専門職大学です。1・2年次にビジネスの基礎を学び、3・4年次は企業や地域と実際の課題に取り組み、4年間で600時間のインターンシップと4年次の事業創生実習で事業づくりを経験します。",
   "only": [
    {
     "t": "4年間で600時間のインターンシップを行い、350以上の提携企業・団体から10社以上を選べる。海外（アメリカ・オーストラリア・フィリピンなど）のインターンシップもある。",
     "src": "https://gpu.ac.jp/undergraduate/internship/"
    },
    {
     "t": "4年次に全学生が「事業創生実習」に取り組み、チームで事業ビジョン・市場分析から成果発表までを行う。",
     "src": "https://gpu.ac.jp/undergraduate/business-creation/"
    },
    {
     "t": "男女とも学生寮がある。",
     "src": "https://manabi.benesse.ne.jp/daigaku/school/3388/"
    }
   ],
   "vs": [
    {
     "u": "情報経営イノベーション専門職大学（iU）",
     "t": "iUは東京都墨田区で情報経営イノベーション学部（入学定員160）を置くが、この大学は川崎市のグローバルビジネス学部（入学定員98）で、600時間のインターンシップと事業創生実習を軸に学ぶ。",
     "src": "https://search.keinet.ne.jp/2106/outline/department"
    }
   ]
  }
 }
