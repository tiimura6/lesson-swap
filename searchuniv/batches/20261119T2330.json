 {
  "name": "静岡英和学院大学",
  "story": {
   "summary": "静岡市駿河区池田の人間社会学部（人間社会学科・コミュニティ福祉学科）の大学で、1年次は各分野の基礎を学び、2年次以降に学科とメジャーを選ぶ「Late Specialization」を取り入れている。心理・経済経営・観光地域デザイン・英語文化・日本語文化、保育・幼児教育・社会福祉・福祉心理などのメジャーがあり、社会福祉士の受験資格や保育士・幼稚園教諭などを組み合わせてめざせる。入学時に専門を決めきれていない生徒や、福祉・保育・心理を組み合わせて学びたい生徒に話しやすい。",
   "only": [
    {
     "t": "1年次は各分野の基礎科目を学び、2年次以降に学科とメジャー（専門分野）を選ぶ「Late Specialization」を導入しており、異なる分野の科目を組み合わせて学ぶこともできる。",
     "src": "https://www.shizuoka-eiwa.ac.jp/department/university/"
    },
    {
     "t": "人間社会学科には心理・経済経営・観光地域デザイン・英語文化・日本語文化、コミュニティ福祉学科には保育・幼児教育・社会福祉・福祉心理・ソーシャルサービス・イノベーションのメジャーがある。",
     "src": "https://www.shizuoka-eiwa.ac.jp/department/university/"
    },
    {
     "t": "コミュニティ福祉学科では社会福祉士の国家試験受験資格のほか、保育士・幼稚園教諭一種免許状・高等学校教諭一種免許状（福祉）を組み合わせてめざせ、福祉心理メジャーは公認心理師（大学院修了または所定の実務が必要）を想定している。",
     "src": "https://www.shizuoka-eiwa.ac.jp/department/subject/community-welfare/"
    },
    {
     "t": "「I＋Brand（アイブランド）プロジェクト」の一環として少人数ゼミで基礎技能・専門知識・社会人基礎力を育て、コミュニティ福祉学科は1・2年次に基礎演習、3・4年次に専門演習がある。",
     "src": "https://www.shizuoka-eiwa.ac.jp/department/university/"
    }
   ],
   "vs": [
    {
     "u": "静岡福祉大学",
     "t": "静岡福祉大学は焼津市にあり、社会福祉学部を福祉心理学科・健康福祉学科に分け、子ども学科で保育士・幼稚園教諭1種・小学校教諭1種をめざすが、静岡英和学院大学は静岡市駿河区で、1年次に基礎を学んでから2年次以降に学科とメジャーを選べ、福祉・保育のほか心理・経済経営・観光なども同じ学部で学べる。",
     "src": "https://www.shizuoka-eiwa.ac.jp/department/university/"
    },
    {
     "u": "常葉大学",
     "t": "常葉大学は10学部を持つ総合大学で、保育は保育学部、心理は教育学部心理教育学科など学部ごとに分かれているが、静岡英和学院大学は人間社会学部1学部の中で、保育・社会福祉・心理などのメジャーを2年次以降に選ぶ。",
     "src": "https://search.keinet.ne.jp/2427/outline/expense"
    }
   ]
  }
 },
 {
  "name": "高岡法科大学",
  "story": {
   "summary": "富山県高岡市の法学部法学科の大学で、1年次に「法学入門」「基礎演習（ゼミ形式）」などで法律の基礎と大学での学び方を身につけ、2年次進級時にコースを選ぶ。公共政策コースは公務員試験対策講座、法律系のコースは法律系資格試験対策講座、企業経営コースは簿記・情報処理・語学の対策講座を備える。北陸で法律を軸に学び、公務員や法律系資格、地元企業をめざしたい生徒に話しやすい。",
   "only": [
    {
     "t": "1年次は法律の基礎と大学での基本的な学力を学び、2年次進級時に公共政策コース・企業経営コースなどのコースを選ぶ。",
     "src": "https://www.takaoka.ac.jp/law"
    },
    {
     "t": "公共政策コースは地域行政や公益法人で活躍する人材を養成し、公務員試験対策講座などの特別科目がある。",
     "src": "https://www.takaoka.ac.jp/law"
    },
    {
     "t": "めざせる資格・進路として、公務員（行政職・警察・消防など）・裁判所職員・労働基準監督官のほか、司法書士・行政書士・宅地建物取引士・社会保険労務士、簿記・ビジネス実務法務検定などが挙げられている。",
     "src": "https://www.takaoka.ac.jp/law"
    },
    {
     "t": "基本方針に「郷土を愛し、その発展を願う人材の育成」「地域と連携し、地域文化の発展に寄与する人材の育成」と、法律教育を中心にリーガルマインドを育てることを掲げている。",
     "src": "https://www.takaoka.ac.jp/about/kengaku"
    }
   ],
   "vs": [
    {
     "u": "富山大学",
     "t": "富山大学は経済学部経済経営学科の中に公共政策プログラムを置くが、高岡法科大学は法学部法学科で法律を軸に学び、公共政策コースで公務員試験対策講座を受けられる。",
     "src": "https://search.keinet.ne.jp/1190/outline/department"
    },
    {
     "u": "金沢星稜大学",
     "t": "金沢星稜大学は経済学部に経済学科・経営学科・地域システム学科を置くが、高岡法科大学は法学部法学科の中に企業経営コースを置き、ビジネス法務の基礎に加えて経済・金融・経営を学ぶ。",
     "src": "https://www.seiryo-u.ac.jp/u/"
    }
   ]
  }
 }
