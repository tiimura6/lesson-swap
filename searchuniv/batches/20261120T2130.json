 {
  "name": "新潟医療福祉大学",
  "story": {
   "summary": "新潟医療福祉大学は新潟市北区にある6学部16学科の医療・福祉系大学で、学科の枠を越えて他学科の学生とチームを組む「連携教育」でチーム医療・ケアを学ぶ。全16学科で約70種類の資格取得に対応し、臨床工学技士＋臨床検査技師のような国家資格のダブルライセンスも目指せる。医療職を目指しつつ、他職種と一緒に学ぶ環境を重視する生徒に話しやすい。",
   "only": [
    {
     "t": "他学科の学生と一つのチームで学ぶ「連携教育」で、学科の枠を越えてチーム医療・ケアを学ぶ",
     "src": "https://manabi.benesse.ne.jp/daigaku/school/3410/"
    },
    {
     "t": "全16学科で約70種類の資格取得に対応し、臨床技術学科では臨床工学技士と臨床検査技師のダブルライセンスを目指せる",
     "src": "https://manabi.benesse.ne.jp/daigaku/school/3410/"
    },
    {
     "t": "全国の養成校でも導入例の少ない3テスラの高磁場MRI装置を実習に使う",
     "src": "https://manabi.benesse.ne.jp/daigaku/school/3410/"
    },
    {
     "t": "基礎ゼミは7〜8人程度のグループに教員1人が付く少人数制",
     "src": "https://manabi.benesse.ne.jp/daigaku/school/3410/"
    }
   ],
   "vs": [
    {
     "u": "新潟リハビリテーション大学",
     "t": "新潟リハビリテーション大学はリハビリテーション学科1学科（理学療法・作業療法・心理の3専攻）の規模で学ぶが、新潟医療福祉大学は看護・医療技術・社会福祉など6学部16学科があり、他学科と組む連携教育がある。",
     "src": "https://nur.ac.jp/department/"
    }
   ]
  }
 },
 {
  "name": "新潟国際情報大学",
  "story": {
   "summary": "新潟国際情報大学は国際学部（国際文化学科）と経営情報学部（経営学科・情報システム学科）の2学部3学科の大学で、新潟市西区のみずき野キャンパスと中央区の新潟中央キャンパスで学ぶ。10〜20人規模の少人数授業、独自の英語教育プログラムCEP、奨学金つきで4年間で卒業できる留学制度があり、国際と情報・経営を地元新潟で学びたい生徒に話しやすい。",
   "only": [
    {
     "t": "国際学部は本学独自の総合的英語教育プログラム「CEP（Communicative English Program）」で学ぶ",
     "src": "https://manabi.benesse.ne.jp/daigaku/school/3404/gakubu/"
    },
    {
     "t": "奨学金が給付される留学制度があり、単位認定で4年間での卒業が可能（国際学部は2年次後期に約半年の派遣留学、経営情報学部はカナダ・アルバータ大学で4週間の短期留学、いずれも希望制）",
     "src": "https://manabi.benesse.ne.jp/daigaku/school/3404/"
    },
    {
     "t": "経営情報学部はITパスポート・基本情報技術者・日商簿記・情報セキュリティマネジメントなどの資格に対応した講義科目がある",
     "src": "https://manabi.benesse.ne.jp/daigaku/school/3404/gakubu/"
    }
   ],
   "vs": [
    {
     "u": "新潟県立大学",
     "t": "新潟県立大学は国際地域・国際経済・人間生活の3学部の公立大学だが、新潟国際情報大学は国際学部と、経営学科・情報システム学科をもつ経営情報学部の2学部で、国際と情報を1つの大学で学べる。",
     "src": "https://search.keinet.ne.jp/1544/outline/department"
    }
   ]
  }
 }
